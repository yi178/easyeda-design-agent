{
  "name": "easyeda-design-agent",
  "version": "0.1.0-readonly-graph.0",
  "private": true,
  "type": "module",
  "description": "EasyEDA-first AI hardware design platform for read-only snapshots, design graphs, review skills, and validation-gated plans.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.17.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "review:fixture": "node apps/cli/src/index.mjs fixtures/snapshots/stm32-minimal-snapshot.json runs/stm32-minimal-review",
    "review:schematic": "node apps/cli/src/index.mjs fixtures/schematic/stm32-minimal-schematic.json runs/schematic-stm32-review",
    "test:schematic-captured": "node scripts/test-captured-schematic.mjs",
    "build:easyeda-bridge": "npm run build --workspace apps/easyeda-bridge-extension",
    "lint": "node scripts/check-docs.mjs",
    "test": "node evals/run-evals.mjs",
    "eval": "node evals/run-evals.mjs"
  }
}
